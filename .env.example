# The port the site runs on
WEBSITE_PORT=8081

# mysql config
MYSQL_ROOT_PASSWORD=changeme!
MYSQL_DATABASE=ultiorganizer
MYSQL_USER=ultiorganizer
MYSQL_PASSWORD=changeme!
MYSQL_DATABASE_FOLDER=db-data

# Folder config

# UltiOrganizer `config.inc.php` written by `install.php` (DB credentials, settings)
UO_CONF_FOLDER=uo_conf
# User-uploaded images (team logos, player photos)
UO_UPLOADS_FOLDER=uploads
# Live! by BULA `local-config.json` written by the admin panel (season, URLs, theme)
LIVE_CONF_FOLDER=live-conf
# Team photo `.jpg` files uploaded for Live! by BULA team pages
LIVE_TEAMS_FOLDER=live-teams
# File-based JSON cache — auto-regenerated from the DB on every request
LIVE_DATA_FOLDER=live-data
